# Terraform state — never commit
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Variable files with real values — copy from terraform.tfvars.example
*.tfvars
!terraform.tfvars.example

# Saved plan files (can contain secrets from state)
tfplan
tfplan-*
*.tfplan

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
